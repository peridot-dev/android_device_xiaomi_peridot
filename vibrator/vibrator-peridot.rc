service vendor.vibrator-peridot /vendor/bin/hw/android.hardware.vibrator-service.peridot
    class hal
    user system
    group system input

on fs
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.i2c/i2c-2/2-005a/activate
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.i2c/i2c-2/2-005a/activate_mode
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.i2c/i2c-2/2-005a/duration
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.i2c/i2c-2/2-005a/effect_id
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.i2c/i2c-2/2-005a/index
