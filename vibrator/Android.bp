cc_library_static {
    name: "libvibratorperidotimpl",
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V2-ndk",
    ],
    export_include_dirs: ["include"],
    srcs: [
        "Vibrator.cpp",
    ],
}

cc_binary {
    name: "android.hardware.vibrator-service.peridot",
    relative_install_path: "hw",
    init_rc: ["vibrator-peridot.rc"],
    vintf_fragments: ["android.hardware.vibrator.peridot.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V2-ndk",
    ],
    static_libs: [
        "libvibratorperidotimpl",
    ],
    srcs: ["main.cpp"],
}
